
import heapq

def kth_largest(nums, k):
    if k < 1 or k > len(nums):
        raise ValueError("Invalid value of k")

    min_heap = []

    for num in nums:
        heapq.heappush(min_heap, num)

        if len(min_heap) > k:
            heapq.heappop(min_heap)

    return min_heap[0]


# Testing
numbers = [3, 2, 1, 5, 6, 4]

print("2nd Largest:", kth_largest(numbers, 2))
print("1st Largest:", kth_largest(numbers, 1))
print("3rd Largest:", kth_largest(numbers, 3))
