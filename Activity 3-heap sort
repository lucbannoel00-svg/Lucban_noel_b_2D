
def heap_sort(arr):
    arr = arr.copy()
    n = len(arr)

    def heapify(n, i):
        largest = i
        left = 2 * i + 1
        right = 2 * i + 2

        if left < n and arr[left] > arr[largest]:
            largest = left

        if right < n and arr[right] > arr[largest]:
            largest = right

        if largest != i:
            arr[i], arr[largest] = arr[largest], arr[i]
            heapify(n, largest)

    # Build max-heap
    for i in range(n // 2 - 1, -1, -1):
        heapify(n, i)

    # Extract elements
    for i in range(n - 1, 0, -1):
        arr[0], arr[i] = arr[i], arr[0]
        heapify(i, 0)

    return arr


# Testing
print("Normal:", heap_sort([4, 10, 3, 5, 1]))
print("Sorted:", heap_sort([1, 2, 3, 4, 5]))
print("Reverse:", heap_sort([5, 4, 3, 2, 1]))
print("Duplicates:", heap_sort([4, 1, 4, 2, 1]))
print("Empty:", heap_sort([]))
